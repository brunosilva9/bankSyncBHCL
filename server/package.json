{
  "name": "syncbanks-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "user:add": "tsx --env-file-if-exists=../.env src/cli/addUser.ts",
    "import": "tsx --env-file-if-exists=../.env src/cli/importFiles.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx --env-file-if-exists=../.env src/cli/backup.ts"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
