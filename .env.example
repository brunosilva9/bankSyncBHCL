# Clave de cifrado de la base de datos (SQLCipher). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# IMPORTANTE: si se pierde, los datos no se pueden recuperar. Guardarla en un gestor de contraseñas.
DB_KEY=

# Opcionales
# PORT=3001
# DB_PATH=./data/syncbanks.db   (su carpeta es la carpeta de datos: usuarios.db y bases/ van ahí)
# SESSION_DAYS=7
# NODE_ENV=production
# Hora de Chile (0 a 23) a la que el servidor cierra solo el día anterior; "no" lo apaga.
# CIERRE_HORA=2
